# Copy to .env for local development. Never commit .env or real credentials.
# On Render, use the internal database hostname in render.yaml instead.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/my_portofolio
SPRING_DATASOURCE_USERNAME=my_portofolio_user
SPRING_DATASOURCE_PASSWORD=replace-me
SPRING_FLYWAY_ENABLED=true
APP_FRONTEND_ORIGIN=https://efatha.github.io
