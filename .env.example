# Copy to .env for local development. Never commit .env or real credentials.
# On Render, set these same variables in the web service environment.
SPRING_DATASOURCE_URL=jdbc:postgresql://your-neon-host/my_portofolio_db?sslmode=require&channel_binding=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your-neon-password
SPRING_FLYWAY_ENABLED=true
APP_FRONTEND_ORIGIN=https://efatha.github.io
